    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Lime journey action with a light hover and restrained lift.",
      "html": "<a class=\"ds-primary\" href=\"#experience\">Explore my journey <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 12h15m-6-6 6 6-6 6\"/></svg></a>",
      "css": ".ds-primary{font-family:var(--font-sans,'Manrope Variable',sans-serif);display:inline-flex;align-items:center;justify-content:center;gap:20px;min-height:54px;padding:0 25px;border-radius:999px;background:var(--lime,#b4ff3c);color:var(--charcoal,#191b18);font-size:15px;font-weight:650;text-decoration:none;transition:background .2s,transform .2s}.ds-primary:hover{background:#caff72;transform:translateY(-2px)}.ds-primary:focus-visible{outline:2px solid var(--blue,#466d10);outline-offset:6px}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}}"
    },
    {
      "name": "Navigation",
      "kind": "nav",
      "refersTo": "navigation",
      "description": "Charcoal desktop navigation specimen; production collapses to an accessible menu below 700px.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Main navigation\"><a class=\"ds-mark\" href=\"#home\" aria-label=\"Gagan Chugh, home\">GC<span>.</span></a><div class=\"ds-links\"><a href=\"#about\">About</a><a href=\"#experience\">Experience</a><a href=\"#impact\">Impact</a></div><a class=\"ds-connect\" href=\"#contact\">Let’s connect <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M6 18 18 6M6 6h12v12\"/></svg></a></nav>",
      "css": ".ds-nav{font-family:var(--font-sans,'Manrope Variable',sans-serif);display:flex;align-items:center;justify-content:space-between;gap:24px;min-height:96px;padding:0 24px;background:var(--charcoal,#191b18);color:#fff}.ds-nav a{text-decoration:none;color:inherit}.ds-mark{font-size:38px;font-weight:750;letter-spacing:-.04em;line-height:1}.ds-mark span{color:var(--lime,#b4ff3c)}.ds-links{display:flex;flex-wrap:wrap;gap:28px}.ds-links a{font-size:15px;font-weight:500;color:#e2e5dd}.ds-links a:hover{color:var(--lime,#b4ff3c)}.ds-connect{display:inline-flex;align-items:center;gap:16px;min-height:46px;padding:0 22px;border-radius:999px;background:var(--lime,#b4ff3c);color:var(--charcoal,#191b18)!important;font-size:15px;white-space:nowrap}.ds-connect:hover{background:#caff72}.ds-nav a:focus-visible{outline:2px solid var(--lime,#b4ff3c);outline-offset:6px}@media(max-width:600px){.ds-nav{flex-wrap:wrap;padding-block:16px}.ds-links{order:3;width:100%}}"
    },
    {
      "name": "Tool Chip",
      "kind": "chip",
      "refersTo": "tool-chip",
      "description": "Static tool label; intentionally has no action or selected state.",
      "html": "<span class=\"ds-chip\">Advanced Excel</span>",
      "css": ".ds-chip{font-family:var(--font-sans,'Manrope Variable',sans-serif);display:inline-block;padding:10px 17px;border-radius:999px;background:#e8eddf;color:#35432b;font-size:14px}"
    },
    {
      "name": "Impact Panel",
      "kind": "card",
      "refersTo": "impact-panel",
      "description": "Confirmed delivery improvement displayed on a lime content panel.",
      "html": "<article class=\"ds-impact\"><div class=\"ds-top\">Delivery reliability <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M6 18 18 6M6 6h12v12\"/></svg></div><div class=\"ds-figure\"><span>94<small>%</small></span><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 12h15m-6-6 6 6-6 6\"/></svg><strong>98<small>%</small></strong></div><h3>More deliveries.<br>Right on time.</h3><p>Improved OTIF through structured dispatch planning, carrier coordination and SAP-enabled process standardisation.</p><div class=\"ds-track\" aria-hidden=\"true\"><span></span></div><div class=\"ds-label\"><span>On time. In full.</span><span>98% OTIF</span></div></article>",
      "css": ".ds-impact{font-family:var(--font-sans,'Manrope Variable',sans-serif);padding:36px;border-radius:18px;background:transparent;color:var(--ink,#20231d)}.ds-top{display:flex;align-items:center;justify-content:space-between;font-size:15px;color:#35431e}.ds-figure{display:flex;align-items:center;gap:20px;margin:38px 0 22px;font-size:76px;font-weight:450;letter-spacing:-.04em;line-height:1.1;color:#546b37}.ds-figure strong{color:var(--charcoal,#191b18);font-weight:500}.ds-figure small{font-size:31px}.ds-figure>svg{width:40px;flex-shrink:0}.ds-impact h3{font-size:32px;font-weight:550;line-height:1.3;letter-spacing:-.025em;margin:0 0 15px}.ds-impact p{font-size:16px;line-height:1.9;color:#344322;margin:0}.ds-track{height:3px;background:transparent;margin-top:35px}.ds-track span{display:block;width:98%;height:100%;background:transparent}.ds-label{display:flex;justify-content:space-between;margin-top:10px;font-size:12px;color:#344322}@media(max-width:450px){.ds-impact{padding:26px}.ds-figure{font-size:62px;gap:12px}.ds-impact h3{font-size:28px}}"
    },
    {
      "name": "FAQ",
      "kind": "custom",
      "description": "Native details/summary with a charcoal open state and lime indicator.",
      "html": "<details class=\"ds-faq\"><summary>What is your current role?<span class=\"ds-plus\" aria-hidden=\"true\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 14 14\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.3\"><path d=\"M7 2v10M2 7h10\"/></svg></span></summary><p>I am Manager – Logistics, Mobile Division, at Samsung India Electronics in Noida. I lead warehouse, dispatch, transportation and 3PL operations.</p></details>",
      "css": ".ds-faq{font-family:var(--font-sans,'Manrope Variable',sans-serif);border:1px solid var(--line,#e1e5dc);border-radius:16px;padding:24px 28px;background:var(--white,#fff);color:var(--ink,#20231d)}.ds-faq summary{display:flex;align-items:center;justify-content:space-between;gap:20px;list-style:none;cursor:pointer;font-size:19px;font-weight:550}.ds-faq summary::-webkit-details-marker{display:none}.ds-plus{display:grid;place-items:center;flex-shrink:0;width:32px;height:32px;border-radius:50%;background:#20231d;color:#fff}.ds-faq summary:hover .ds-plus{background:#466d10}.ds-faq summary:focus-visible{outline:2px solid #729b37;outline-offset:8px;border-radius:4px}.ds-faq[open]{background:var(--charcoal,#191b18);border-color:var(--charcoal,#191b18);color:#fff}.ds-faq[open] .ds-plus{background:var(--lime,#b4ff3c);color:var(--charcoal,#191b18);transform:rotate(45deg)}.ds-faq p{margin:0;padding-top:18px;font-size:16px;line-height:1.75;color:#d5ddcb}"
    },
    {
      "name": "Contact Form",
      "kind": "input",
      "refersTo": "contact-field",
      "description": "Standalone native mailto specimen with required fields; production encodes a draft URL and announces status.",
      "html": "<section class=\"ds-contact\"><form class=\"ds-form\" action=\"mailto:gaganchugh25@gmail.com\" method=\"post\" enctype=\"text/plain\"><h3>Let’s start a conversation.</h3><label for=\"ds-name\">Your name</label><input id=\"ds-name\" name=\"name\" autocomplete=\"name\" required maxlength=\"120\"><label for=\"ds-email\">Your email</label><input id=\"ds-email\" name=\"email\" type=\"email\" autocomplete=\"email\" required maxlength=\"254\"><label for=\"ds-message\">What would you like to discuss?</label><textarea id=\"ds-message\" name=\"message\" rows=\"4\" required maxlength=\"3000\"></textarea><button type=\"submit\">Open email draft <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M6 18 18 6M6 6h12v12\"/></svg></button><p>Opens a draft in your email app. Your details are not stored on this website.</p></form></section>",
      "css": ".ds-contact{font-family:var(--font-sans,'Manrope Variable',sans-serif);padding:24px;background:radial-gradient(ellipse at right,#54712280,transparent 80%),var(--charcoal,#191b18);color:#fff}.ds-form{padding:32px;border-radius:20px;background:#ffffff0e}.ds-form h3{font-size:26px;font-weight:500;margin:0 0 24px}.ds-form label{display:block;font-size:14px;color:#e1e8d8;margin-bottom:7px}.ds-form input,.ds-form textarea{font-family:var(--font-sans,'Manrope Variable',sans-serif);display:block;width:calc(100% - 30px);border:1px solid #8b9a77;background:#ffffff05;color:#fff;padding:12px 14px;border-radius:8px;font-size:16px;line-height:1.75;margin-bottom:18px;caret-color:var(--lime,#b4ff3c)}.ds-form textarea{resize:vertical}.ds-form input:hover,.ds-form textarea:hover{border-color:#b4c89a}.ds-form input:focus-visible,.ds-form textarea:focus-visible{outline:2px solid var(--lime,#b4ff3c);outline-offset:2px}.ds-form button{font-family:var(--font-sans,'Manrope Variable',sans-serif);display:flex;justify-content:space-between;align-items:center;gap:20px;min-height:54px;width:100%;padding:0 25px;border:0;border-radius:999px;background:var(--lime,#b4ff3c);color:var(--charcoal,#191b18);font-size:15px;font-weight:650;cursor:pointer}.ds-form button:hover{background:#caff72}.ds-form button:focus-visible{outline:2px solid var(--lime,#b4ff3c);outline-offset:6px}.ds-form p{font-size:13px;line-height:1.65;color:#d0d9c4;margin:14px 0 0}"
    }
